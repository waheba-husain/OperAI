# ============================================================
# OperAI / Cloud Kitchen Rescue — Frontend Environment Template
# ============================================================
#
# Vite bundles VITE_* variables into client-side code.
# NEVER put real secrets, production credentials, or private keys here.
#
# Base URL for the OperAI backend REST API (default local: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Shared API key for single-kitchen demo (Rest_API_Spec.md §1)
# Required for all /api endpoints except /health.
# Example local key:
VITE_API_KEY=
